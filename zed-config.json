// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_update": false,
  "ssh_connections": [
    {
      "host": "asque-server",
      "args": [],
      "projects": [
        {
          "paths": ["/root/app"],
        },
      ],
    },
  ],
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
    "group_by": "staging",
    "tree_view": false,
  },
  "diff_view_style": "split",
  "edit_predictions": {
    "allow_data_collection": "no",
    "copilot": {
      "prediction_debounce": 100,
    },
    "provider": "copilot",
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false,
  },
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "favorite_config_option_values": {
        "model": ["claude-sonnet-4-6", "sonnet", "claude-opus-5", "opus"],
        "mode": ["plan"],
      },
      "default_config_options": {
        "effort": "medium",
        "model": "opus",
        "mode": "auto",
        "fast": false,
      },
      "type": "registry",
    },
  },
  "lsp": {
    "java": {
      "settings": {
        "java_home": "/Users/mac/.sdkman/candidates/java/21.0.11-tem",
        "lombok_support": true,
      },
      "initialization_options": {
        "settings": {
          "java": {
            "configuration": {
              "runtimes": [
                {
                  "name": "JavaSE-17",
                  "path": "/Users/mac/.sdkman/candidates/java/17.0.19-tem",
                },
                {
                  "name": "JavaSE-21",
                  "path": "/Users/mac/.sdkman/candidates/java/21.0.11-tem",
                  "default": true,
                },
              ],
            },
            "import": { "maven": { "enabled": true } },
            "format": { "enabled": true },
            "saveActions": { "organizeImports": false },
          },
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    // "jdtls": {
    //   "settings": {
    //     "java_home": "/Users/mac/.sdkman/candidates/java/21.0.11-tem",
    //     "lombok_support": true,
    //   },
    //   "initialization_options": {
    //     "settings": {
    //       "java": {
    //         "configuration": {
    //           "runtimes": [
    //             {
    //               "name": "JavaSE-21",
    //               "path": "/Users/mac/.sdkman/candidates/java/current",
    //               "default": true,
    //             },
    //           ],
    //         },
    //         "import": { "maven": { "enabled": true } },
    //         "format": { "enabled": true },
    //         "saveActions": { "organizeImports": false },
    //       },
    //     },
    //   },
    // },
  },
  "languages": {
    "Java": {
      "tab_size": 4,
      "hard_tabs": false,
      "language_servers": ["java", "!jdtls", "..."],
    },
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "left",
    "default_model": {
      "provider": "x_ai",
      "model": "grok-4.6",
      "enable_thinking": true,
      "effort": "high",
    },
    "favorite_models": [],
    "model_parameters": [],
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
    },
  },
  "project_panel": {
    "dock": "right",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": false,
  "minimap": {
    "show": "always",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "linked_edits": true,
  "wrap_guides": [],
  "base_keymap": "VSCode",
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 14.5,
  "buffer_font_size": 13.5,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark",
  },
}
